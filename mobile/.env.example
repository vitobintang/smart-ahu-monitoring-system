# Public HTTPS origin for the deployed Next.js API. Required for native builds.
# Leave empty for browser development; Vite proxies /api to localhost:3000.
VITE_API_BASE_URL=https://your-production-api.example.com

# Firebase projects in this deployment:
# 1) AUTH/identity (daikinsmart-efeb7): the app uses this public config only to
#    authenticate users and obtain Firebase ID tokens.
# 2) APP-DATA (smart-monitoring-ahu): server-only; VITE must NOT contain its
#    database URL or service-account credentials. Mobile data goes through the
#    Next.js API, which uses FIREBASE_DATABASE_URL + FIREBASE_SERVICE_ACCOUNT_*.
# 3) OWNER/device tree: also server-only; the API uses OWNER_DEVICES_*.
#
# Fill these values from the AUTH project's Firebase Web App settings.
VITE_FIREBASE_AUTH_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_AUTH_PROJECT_ID=
VITE_FIREBASE_AUTH_APP_ID=

# APP-DATA Firebase is intentionally not configured in this mobile client.
# Telemetry, alarms, roles, and app records are accessed through the Next.js API.
# Keep FIREBASE_SERVICE_ACCOUNT_* and APP-DATA database credentials server-side.

# Optional target for the local Vite API proxy.
NEXT_DEV_ORIGIN=http://localhost:3000
