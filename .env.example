# Server-only Supabase PostgreSQL connection (session pooler; never NEXT_PUBLIC_).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DIRECT_URL=

# Supabase Auth (publishable values can be used in browser bundles).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only key for administrator user creation. NEVER expose publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Demo data only. Set both to false to prevent automatic simulated telemetry/history.
SIMULATION_ENABLED=true
SEED_SIMULATED_HISTORY=true