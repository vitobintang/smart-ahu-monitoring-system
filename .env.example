# Two-project layout (recommended):
#   AUTH project        — the collaborator's Firebase: sign-in accounts +
#                         devices/{id} live data + deviceOwners/{id} tokens.
#   APP-DATA project    — YOUR Firebase: users (role profiles), telemetry
#                         history, thresholds, gateways, commands, alarms,
#                         audit, 3D floorplan. Create it free in 2 minutes.
# Single-project mode also works: point everything at one project.

# Demo data only. Set to false to prevent automatic simulated telemetry/history.
SIMULATION_ENABLED=true

# Telemetry retention sweep (workers.ts): days of per-day telemetry shards to keep.
# TELEMETRY_RETENTION_DAYS=366
# ─── Native mobile API CORS ─────────────────────────────────────────────────
# Capacitor's bundled iOS/Android WebViews use these exact origins by default.
# Add only additional origins you control; do not use a wildcard.
# MOBILE_APP_ORIGINS=https://mobile.your-company.example

# ─── Firebase (Auth identity + app data) ─────────────────────────────────────
# The PUBLIC config below is the AUTH project: sign-in (Email/Password),
# accounts and session cookies live there. Tip: keep it on the collaborator
# project so its existing accounts keep working — you then do NOT need to
# enable any sign-in provider in your own project.
# Public web-app identifiers (safe to expose — they identify, not authorize).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# APP-DATA project server connection. In the recommended two-project setup,
# this URL and service account belong to YOUR app-data project (users/roles,
# telemetry history, alarms, audit, and controls). Keep them on the Next.js
# server; the mobile app talks to this project only through the API.
# For single-project mode only, leave FIREBASE_DATABASE_URL empty to reuse
# NEXT_PUBLIC_FIREBASE_DATABASE_URL above.
FIREBASE_DATABASE_URL=

# SERVER-ONLY secret — downloaded service-account JSON for YOUR app-data
# project. Name it after that project, e.g. ./smart-monitoring-ahu-service-account.json
# Provide ONE of:
#   FIREBASE_SERVICE_ACCOUNT_PATH=./<project-id>-service-account.json
#   FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","private_key":"..."}
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Auth admin operations ───────────────────────────────────────────────────
# Session cookies, token verification and user management talk to the AUTH
# project, so they need the AUTH project's service account. Defaults cascade:
# FIREBASE_AUTH_* -> OWNER_DEVICES_* -> the app account above (single-project).
FIREBASE_AUTH_SERVICE_ACCOUNT_PATH=
FIREBASE_AUTH_SERVICE_ACCOUNT_JSON=

# ─── Device project (OWNER devices tree) ─────────────────────────────────────
# The project that owns devices/{id} (live device state) and deviceOwners/{id}
# (pre-shared device tokens) — usually the SAME collaborator project as the
# AUTH block above, so point these at the same database + service account.
# Server-only. When BOTH are unset, the app-data project serves this role
# (single-project mode).
# INVARIANT: the app never creates new top-level nodes on this database —
# access is code-confined (guardRtdbRoots) to the EXISTING devices/ +
# deviceOwners/ trees only. Nothing else is ever written or read there.
OWNER_DEVICES_DATABASE_URL=
OWNER_DEVICES_SERVICE_ACCOUNT_PATH=
OWNER_DEVICES_SERVICE_ACCOUNT_JSON=

# OPTIONAL — shared Realtime Database namespace (leave empty: your app-data
# database is dedicated). Only set (e.g. "some-ns") if the APP-DATA database
# also hosts other apps' data that must not be touched.
RTDB_PATH_PREFIX=