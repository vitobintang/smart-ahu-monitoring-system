# Project layout:
#   AUTH/identity — collaborator project daikinsmart-efeb7: sign-in accounts.
#   APP-DATA     — your project smart-monitoring-ahu: roles, telemetry history,
#                  thresholds, alarms, audit, controls, and application records.
#   OWNER/device — collaborator project: devices/{id} and deviceOwners/{id}.
# AUTH and OWNER may use the same collaborator project/service account.

SIMULATION_ENABLED=true

# Telemetry retention sweep (workers.ts): days of per-day telemetry shards to keep.
# TELEMETRY_RETENTION_DAYS=366

# Capacitor iOS/Android origins are allowed by default. Add only trusted origins.
# MOBILE_APP_ORIGINS=https://mobile.your-company.example

# ─── AUTH project public web config ──────────────────────────────────────────
# These identify the Firebase web app; they are not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── APP-DATA project (your smart-monitoring-ahu database) ───────────────────
# The server-side APP-DATA database URL. This is not the mobile API URL.
FIREBASE_DATABASE_URL=https://smart-monitoring-ahu-default-rtdb.asia-southeast1.firebasedatabase.app

# APP-DATA Admin credential. Choose ONE method:
# - Local .env: FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON, or wrap the
#   entire multiline JSON value in single quotes so dotenv reads it as one value).
# - Vercel: FIREBASE_SERVICE_ACCOUNT with the raw JSON value (no outer quotes).
# - Local file: FIREBASE_SERVICE_ACCOUNT_PATH.
# Keep all of these server-only: never use NEXT_PUBLIC_ or VITE_ prefixes.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=./smart-monitoring-ahu-service-account.json

# ─── AUTH Admin credential (optional override) ───────────────────────────────
# Session/token operations need the AUTH project's service account. If AUTH
# and OWNER are the same collaborator project, the OWNER credentials below are
# used automatically; set these only when AUTH needs a different credential.
FIREBASE_AUTH_SERVICE_ACCOUNT_JSON=
# FIREBASE_AUTH_SERVICE_ACCOUNT_PATH=./auth-service-account.json

# ─── OWNER/device project (collaborator devices tree) ────────────────────────
# OWNER database URL, typically the collaborator's existing RTDB URL.
OWNER_DEVICES_DATABASE_URL=
# Local .env multiline JSON must also be wrapped in single quotes. These
# credentials are server-only and restricted by code to devices/ + deviceOwners/.
OWNER_DEVICES_SERVICE_ACCOUNT_JSON=
# OWNER_DEVICES_SERVICE_ACCOUNT_PATH=./daikinsmart-service-account.json

# Optional shared RTDB namespace. Leave empty for a dedicated APP-DATA database.
RTDB_PATH_PREFIX=
